CREATE TABLE notification_log (
    id             INTEGER PRIMARY KEY AUTOINCREMENT,
    item_id        INTEGER NOT NULL REFERENCES item(id) ON DELETE CASCADE,
    scheduled_date TEXT NOT NULL,
    is_sent        INTEGER NOT NULL DEFAULT 0,
    created_at     TEXT NOT NULL
);

CREATE INDEX notification_log_item_idx ON notification_log(item_id);

selectAll:
SELECT * FROM notification_log ORDER BY scheduled_date DESC, id DESC;

selectById:
SELECT * FROM notification_log WHERE id = ?;

selectByItem:
SELECT * FROM notification_log WHERE item_id = ? ORDER BY scheduled_date ASC;

insert:
INSERT INTO notification_log (item_id, scheduled_date, is_sent, created_at)
VALUES (?, ?, ?, ?);

markSent:
UPDATE notification_log SET is_sent = 1 WHERE id = ?;

delete:
DELETE FROM notification_log WHERE id = ?;

deleteByItem:
DELETE FROM notification_log WHERE item_id = ?;

lastInsertRowId:
SELECT last_insert_rowid();

deleteAll:
DELETE FROM notification_log;
